{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "target": "esnext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"],
        "typeRoots": ["./node_modules/@types"]
    },
    "include": ["src/**/*"]
}